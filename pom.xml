                        <version>2.1.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
                        <artifactId>fast-deep-equal</artifactId>
                        <version>3.1.3</version>
                    </dependency>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
