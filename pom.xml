    <build>
        <finalName>${finalName}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>

                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <!-- License headers can be automatically updated using `mvn validate license:format`, no need to change year. -->
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${maven.license-plugin.version}</version>

                <executions>
                    <execution>
                        <id>check-copyright-headers</id>
                        <phase>package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <licenseSets>
                        <licenseSet>
                            <header>LICENSE_HEADER</header>
                            <excludes>
                                <exclude>src/test/resources/**/*</exclude>
                                <exclude>.devbox/**/*</exclude>
                                <exclude>templates/**/*</exclude>
                                <exclude>**/*.properties</exclude>
                                <exclude>**/*.yml</exclude>
                                <exclude>**/*.yaml</exclude>
                                <exclude>**/*.json</exclude>
                                <exclude>**/*.raml</exclude>
                                <exclude>**/*.sh</exclude>
                                <exclude>**/*.txt</exclude>
                                <exclude>**/*.xml</exclude>
                                <exclude>data/**</exclude>
                                <exclude>LICENSE</exclude>
                                <exclude>LICENSE_HEADER</exclude>
                                <exclude>README.md</exclude>
                                <exclude>.gitignore</exclude>
                                <exclude>spring-boot-undertow/**</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                    <aggregate>true</aggregate>
                    <strictCheck>true</strictCheck>
                    <properties>
                        <year>${current.year}</year>
                    </properties>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${maven.build-helper-maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>timestamp-property</id>
                        <goals>
                            <goal>timestamp-property</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <name>current.year</name>
                            <pattern>yyyy</pattern>
                            <locale>en-GB</locale>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>net.nicoulaj.maven.plugins</groupId>
                <artifactId>checksum-maven-plugin</artifactId>
                <version>1.5</version>

                <executions>
                    <execution>
                        <id>attach-artifact-checksums</id>
                        <goals>
                            <goal>artifacts</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <attachChecksums>true</attachChecksums>
                    <algorithms>
                        <algorithm>SHA-256</algorithm>
                        <algorithm>MD5</algorithm>
                    </algorithms>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.mvnpm</groupId>
                <artifactId>esbuild-maven-plugin</artifactId>
                <version>${maven.esbuild-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>esbuild</id>
                        <goals>
                            <goal>esbuild</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <entryPoint>index.js</entryPoint>
                    <outputDirectory>target/classes/static/js/bundle</outputDirectory>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
                        <artifactId>react-dom</artifactId>
                        <version>18.3.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
                        <artifactId>react</artifactId>
                        <version>18.3.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
                        <artifactId>rjsf__core</artifactId>
                        <version>6.4.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
                        <artifactId>rjsf__utils</artifactId>
                        <version>6.4.1</version>
                        <exclusions>
                            <exclusion>
                                <groupId>org.webjars.npm</groupId>
                                <artifactId>react-is</artifactId>
                            </exclusion>
                        </exclusions>
                    </dependency>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
                        <artifactId>rjsf__validator-ajv8</artifactId>
                        <version>6.4.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
                        <artifactId>react-is</artifactId>
                        <version>16.13.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
                        <artifactId>x0k__json-schema-merge</artifactId>
                        <version>1.0.2</version>
                    </dependency>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
                        <artifactId>scheduler</artifactId>
                        <version>0.27.0</version>
                    </dependency>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
                        <artifactId>markdown-to-jsx</artifactId>
                        <version>8.0.0</version>
                    </dependency>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
                        <artifactId>lodash-es</artifactId>
                        <version>4.17.23</version>
                    </dependency>
                    <dependency>
                        <groupId>org.webjars.npm</groupId>
